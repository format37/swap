      "Quote": {
        "additionalProperties": false,
        "description": "1 `base` = `value` `quote`, in the direction the author typed it: \u00ab1 GEL = 29,20 RUB\u00bb.",
        "properties": {
          "base": {
            "examples": [
              "GEL"
            ],
            "pattern": "^[A-Z]{3,5}$",
            "title": "Base",
            "type": "string"
          },
