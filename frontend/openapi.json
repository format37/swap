      "OrderDraft": {
        "additionalProperties": false,
        "description": "What the wizard publishes (FR-2.1). A value from a form, checked here for its rules.",
        "properties": {
          "amount_max": {
            "examples": [
              "1500.00"
            ],
            "pattern": "^\\d{1,16}(\\.\\d{1,2})?$",
            "title": "Amount Max",
            "type": "string"
          },
          "amount_min": {
            "examples": [
              "1500.00"
            ],
            "pattern": "^\\d{1,16}(\\.\\d{1,2})?$",
            "title": "Amount Min",
            "type": "string"
          },
          "available_from": {
            "format": "date",
            "title": "Available From",
            "type": "string"
          },
          "available_until": {
            "format": "date",
            "title": "Available Until",
            "type": "string"
          },
          "give_country": {
            "examples": [
              "GE"
            ],
            "pattern": "^[A-Z]{2}$",
            "title": "Give Country",
            "type": "string"
          },
          "give_currency": {
            "examples": [
              "GEL"
            ],
            "pattern": "^[A-Z]{3,5}$",
            "title": "Give Currency",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "payout_methods": {
            "items": {
              "$ref": "#/components/schemas/PaymentKind"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Payout Methods",
            "type": "array"
          },
          "rate_spec": {
            "$ref": "#/components/schemas/FixedRate"
          },
          "visible_to": {
            "anyOf": [
              {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "maxItems": 200,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visible To"
          },
          "wants": {
            "items": {
              "$ref": "#/components/schemas/Want"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Wants",
            "type": "array"
