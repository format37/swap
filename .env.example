# Swap's environment. Copy to .env and fill it in; a blank value counts as unset.
# .env itself is never committed.

# The bot's token from BotFather. It also validates the Mini App's initData.
TELEGRAM_BOT_TOKEN=

# The VPS's own Bot API server, http://127.0.0.1:8081 there (ADR-0008). Leave it
# blank everywhere else: blank means nothing talks to Telegram.
TELEGRAM_API_BASE=

# Postgres. Locally, compose falls back to "swap".
POSTGRES_PASSWORD=

# Error reports go to this Sentry DSN (ADR-0025): the api and the worker at run time,
# the frontend's bundle at build time. Blank sends nothing.
SENTRY_DSN=

# dev, test or prod.
APP_ENV=dev
# json or console.
LOG_FORMAT=console

# To run the api or Alembic on the host against the compose db:
# DATABASE_URL=postgresql+asyncpg://swap:swap@127.0.0.1:5436/swap
